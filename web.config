<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- FastCGI handler for Django using your virtual environment -->
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="FastCgiModule"
           scriptProcessor="D:\Queue Management\venv\Scripts\python.exe|D:\Queue Management\venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.py" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="true" />
  </system.webServer>

  <appSettings>
    <!-- Django WSGI handler -->
    <add key="WSGI_HANDLER" value="qms_project.wsgi.application" />
    <add key="PYTHONPATH" value="D:\Queue Management\qms_project" />
    <add key="DJANGO_SETTINGS_MODULE" value="qms_project.settings" />
    <add key="DJANGO_DEBUG" value="True" />
  </appSettings>
</configuration>
